# Copy to .env and set a Google AI Studio API key.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Temporary Cognee retrieval audit. Set content=true and log level=DEBUG to
# print bounded result content previews and raw response JSON in backend logs.
COGNEE_RETRIEVAL_AUDIT_CONTENT=false
COGNEE_RETRIEVAL_AUDIT_PREVIEW_CHARS=500
CAMPUSCODE_EVALUATION_LOG_LEVEL=INFO

# Gemini report context. The token count is a conservative application estimate.
EVALUATION_CONTEXT_MAX_TOKENS=40000
EVALUATION_CONTEXT_CHARS_PER_TOKEN=2
EVALUATION_CONTEXT_MAX_EVIDENCE_PER_DIMENSION=4
EVALUATION_CONTEXT_MAX_EVIDENCE_CHARS=4000
EVALUATION_CONTEXT_MAX_GRAPH_FACTS=36
EVALUATION_CONTEXT_MAX_GRAPH_DESCRIPTION_CHARS=500

# Local Cognee default account. Keep the backend login values in sync.
DEFAULT_USER_EMAIL=default_user@example.com
DEFAULT_USER_PASSWORD=default_password
COGNEE_USERNAME=default_user@example.com
COGNEE_PASSWORD=default_password

# PostgreSQL local development
POSTGRES_DB=campuscode
POSTGRES_USER=campuscode
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=jdbc:postgresql://localhost:5433/campuscode
DATABASE_USERNAME=campuscode
DATABASE_PASSWORD=replace-with-a-local-password

# Local Mailpit SMTP capture. Start it with:
# docker compose --profile mail up -d mailpit
# View captured messages at http://localhost:8025. These messages are not
# delivered to external inboxes.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=campuscode@localhost
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
