# Copy to .env and set a Google AI Studio API key.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# PostgreSQL local development
POSTGRES_DB=campuscode
POSTGRES_USER=campuscode
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=jdbc:postgresql://localhost:5433/campuscode
DATABASE_USERNAME=campuscode
DATABASE_PASSWORD=replace-with-a-local-password

# Local Mailpit SMTP capture. Start it with:
# docker compose --profile mail up -d mailpit
# View captured messages at http://localhost:8025. These messages are not
# delivered to external inboxes.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=campuscode@localhost
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
